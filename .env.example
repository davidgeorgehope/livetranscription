# Copy to .env and fill in. Cue reads XAI_API_KEY from here by default.
# Settings → xAI API key overrides this (Keychain).
XAI_API_KEY=

# Optional — Grok Bot pre-call briefs. The PREP row's "Grok Bot brief" button POSTs to
# this automation webhook (Authorization: Bearer <key>); the bot writes the brief to
# ~/Library/Application Support/Cue/prep/inbox and Cue attaches it on arrival.
# Grok Bot → your automation → Webhook trigger → copy URL + key.
GROK_BOT_HOOK_URL=
GROK_BOT_HOOK_KEY=

# Optional — Grok Bot post-call summary + follow-ups. When a call ends, Cue POSTs the
# wrap (summary, commitments, draft follow-up, transcript excerpt, and the paths of the
# saved transcript + wrap on this Mac) to this second automation. Calls under ~120 words
# are not sent. Toggle in Settings.
GROK_BOT_SUM_URL=
GROK_BOT_SUM_KEY=

# Optional — Grok Bot day calendar. Cue asks this automation for today's meetings at launch,
# at Listen, and when a meeting app takes the mic (if the last read is missing or over 2h old).
# The bot writes ~/Library/Application Support/Cue/calendar/<yyyy-MM-dd>.json; Cue uses it to
# split back-to-back meetings into separate calls and to aim the Listen-time brief.
GROK_BOT_CALENDAR_URL=
GROK_BOT_CALENDAR_KEY=

# Optional — only for `mine_call_questions.py --gong` (REST fallback; the MCP path
# needs none of these). Gong: Company Settings → Ecosystem → API.
GONG_ACCESS_KEY=
GONG_ACCESS_KEY_SECRET=
GONG_BASE_URL=https://api.gong.io
